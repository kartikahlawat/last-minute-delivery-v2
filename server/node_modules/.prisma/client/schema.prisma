datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String // CUSTOMER, AGENT, ADMIN
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agentProfile         Agent?
  createdOrders        Order[]              @relation("CreatedByOrders")
  customerOrders       Order[]              @relation("CustomerOrders")
  statusHistoryEntries OrderStatusHistory[]
  rescheduleRequests   RescheduleRequest[]
}

model Agent {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String   @default("OFFLINE") // AVAILABLE, BUSY, OFFLINE
  currentZoneId String?
  currentZone   Zone?    @relation(fields: [currentZoneId], references: [id])
  currentLat    Float?
  currentLng    Float?
  vehicleType   String // BIKE, VAN, TRUCK
  updatedAt     DateTime @updatedAt

  assignedOrders Order[]
}

model Zone {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  areas        ZoneArea[]
  pickupOrders Order[]    @relation("PickupZone")
  dropOrders   Order[]    @relation("DropZone")
  agents       Agent[]
}

model ZoneArea {
  id       String @id @default(uuid())
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pincode  String @unique
  areaName String
}

model RateCard {
  id            String   @id @default(uuid())
  orderType     String // B2B, B2C
  relation      String // INTRA, INTER
  ratePerKg     Float
  baseCharge    Float
  minCharge     Float    @default(0)
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
}

model CodSurchargeConfig {
  id            String  @id @default(uuid())
  orderType     String // B2B, B2C
  surchargeType String // FLAT, PERCENT
  value         Float
  isActive      Boolean @default(true)
}

model Order {
  id                 String   @id @default(uuid())
  trackingNumber     String   @unique
  customerId         String
  customer           User     @relation("CustomerOrders", fields: [customerId], references: [id])
  createdByUserId    String
  createdBy          User     @relation("CreatedByOrders", fields: [createdByUserId], references: [id])
  pickupAddress      String
  dropAddress        String
  pickupPincode      String
  dropPincode        String
  pickupZoneId       String?
  pickupZone         Zone?    @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropZoneId         String?
  dropZone           Zone?    @relation("DropZone", fields: [dropZoneId], references: [id])
  lengthCm           Float
  breadthCm          Float
  heightCm           Float
  actualWeightKg     Float
  volumetricWeightKg Float
  billedWeightKg     Float
  orderType          String // B2B, B2C
  paymentType        String // PREPAID, COD
  baseCharge         Float
  codSurcharge       Float
  totalCharge        Float
  currentStatus      String   @default("CREATED") // CREATED, ASSIGNED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED, RESCHEDULED
  assignedAgentId    String?
  assignedAgent      Agent?   @relation(fields: [assignedAgentId], references: [id])
  scheduledDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  statusHistory      OrderStatusHistory[]
  rescheduleRequests RescheduleRequest[]
  notifications      Notification[]
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  actorRole   String // SYSTEM, CUSTOMER, AGENT, ADMIN
  remarks     String?
  createdAt   DateTime @default(now())
}

model RescheduleRequest {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousDate  DateTime
  newDate       DateTime
  reason        String?
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   String // EMAIL, SMS
  recipient String
  status    String // SENT, FAILED
  message   String
  sentAt    DateTime @default(now())
}
